# Copy this file to .env and adjust if needed.
# Matches the credentials defined in docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://nba:nba@localhost:5432/nba_watch

# From @BotFather (see docs/telegram_setup.md)
TELEGRAM_BOT_TOKEN=
# From scripts/get_telegram_chat_id.py
TELEGRAM_CHAT_ID=

# Free tier, from https://app.balldontlie.io/signup (see docs/balldontlie_setup.md)
BALLDONTLIE_API_KEY=

# From https://resend.com/api-keys — used for the non-urgent email digest
RESEND_API_KEY=
# Where digest emails are sent. With the default sandbox sender
# (onboarding@resend.dev, no domain verification needed) this must be
# the same address as the Resend account itself.
DIGEST_EMAIL_TO=
# Optional: only needed once a custom domain is verified with Resend.
RESEND_FROM_EMAIL=
